# Public dummy values for local development only. Do not deploy these values.
# Copy with: cp .env.example .env
ADMIN_TOKEN=local-demo-admin-token-9d6e840b7241b05d
COOKIE_SECRET=local-demo-cookie-secret-c8ed7f5613a9042b
DEDUP_SECRET=local-demo-dedup-secret-a73cb09158ef642d

# Native Go run uses localhost; Compose replaces these database addresses.
CONTROL_DATABASE_URL=postgres://tvpoll:local-only-database-password@localhost:15432/tvpoll?sslmode=disable
SHARD_DATABASE_URLS=postgres://tvpoll:local-only-database-password@localhost:15433/tvpoll?sslmode=disable,postgres://tvpoll:local-only-database-password@localhost:15434/tvpoll?sslmode=disable
PUBLIC_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
BATCH_SIZE=256
BATCH_WAIT_MS=5
WORKERS_PER_SHARD=4
QUEUE_SIZE=4096
MAX_DB_CONNS=8
